diff --git a/oshw/linux/nicdrv.c b/oshw/linux/nicdrv.c
index 190d903..4c791a4 100644
--- a/oshw/linux/nicdrv.c
+++ b/oshw/linux/nicdrv.c
@@ -155,13 +155,8 @@ int ecx_setupnic(ecx_portt *port, const char *ifname, int secondary)
    strcpy(ifr.ifr_name, ifname);
    r |= ioctl(*psock, SIOCGIFINDEX, &ifr);
    ifindex = ifr.ifr_ifindex;
-   strcpy(ifr.ifr_name, ifname);
-   ifr.ifr_flags = 0;
-   /* reset flags of NIC interface */
-   r |= ioctl(*psock, SIOCGIFFLAGS, &ifr);
-   /* set flags of NIC interface, here promiscuous and broadcast */
-   ifr.ifr_flags = ifr.ifr_flags | IFF_PROMISC | IFF_BROADCAST;
-   r |= ioctl(*psock, SIOCSIFFLAGS, &ifr);
+   /* No SIOCSIFFLAGS: it needs CAP_NET_ADMIN and replies are broadcast.
+    * The caller may request promiscuous mode with PACKET_MR_PROMISC. */
    /* bind socket to protocol, in this case RAW EtherCAT */
    sll.sll_family = AF_PACKET;
    sll.sll_ifindex = ifindex;
